# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-build-qa/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
.eslintcache
next-env.d.ts

# local development tooling and QA artifacts
/.cursor/
/.agents/
/.codex/
/.codex-remote-attachments/
/.playwright-cli/
/.local-check-records/
/output/
/tmp/
/supabase/.temp/
*.code-workspace

# Disposable PostgreSQL harness output (see tests/postgres/*-README.md)
/tests/postgres/call-outcome-resolution-*.log
/tests/postgres/call-outcome-resolution-*.log.stderr
/tests/postgres/call-outcome-resolution-instance.txt

# Local Twilio setup notes
/TWILIO_SETUP.md
/TWILIO_PRIVATE_CONTEXT.md

.vercel
